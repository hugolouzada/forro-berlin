---
import EventCard from './EventCard.astro';
import type { ForroEvent } from '../lib/fetchEvents';

interface Props {
  events: ForroEvent[];
  bgColor: string;
}

const { events, bgColor } = Astro.props;
---

<div class="carousel-wrapper">
  <div class="carousel-nav" aria-hidden="true">
    <button class="carousel-btn carousel-btn--prev" aria-label="Previous events">&#8249;</button>
    <button class="carousel-btn carousel-btn--next" aria-label="Next events">&#8250;</button>
  </div>
  <div class="events-grid">
    {events.map(event => (
      <div class="carousel-slide">
        <EventCard
          title={event.title}
          date={event.date}
          time={event.time}
          endTime={event.endTime}
          venue={event.venue}
          type={event.type}
          description={event.description}
          pictureUrl={event.pictureUrl}
          detailUrl={`${event.detailUrl}?backgroundColor=${bgColor}`}
        />
      </div>
    ))}
  </div>
  <button class="carousel-show-more">Show more events ↓</button>
</div>

<script>
document.querySelectorAll<HTMLElement>('.carousel-wrapper').forEach(wrapper => {
  const slides = Array.from(wrapper.querySelectorAll<HTMLElement>('.carousel-slide'));
  const prevBtn = wrapper.querySelector<HTMLButtonElement>('.carousel-btn--prev');
  const nextBtn = wrapper.querySelector<HTMLButtonElement>('.carousel-btn--next');
  const nav = wrapper.querySelector<HTMLElement>('.carousel-nav');
  const showMoreBtn = wrapper.querySelector<HTMLButtonElement>('.carousel-show-more');
  const VISIBLE = 3;
  let offset = 0;
  let expanded = false;

  function mobile() { return window.innerWidth < 640; }

  function update() {
    slides.forEach((slide, i) => {
      slide.hidden = mobile()
        ? (!expanded && i >= VISIBLE)
        : (i < offset || i >= offset + VISIBLE);
    });
    if (nav) nav.hidden = mobile() || slides.length <= VISIBLE;
    if (prevBtn) prevBtn.disabled = offset === 0;
    if (nextBtn) nextBtn.disabled = offset + VISIBLE >= slides.length;
    if (showMoreBtn) showMoreBtn.hidden = !mobile() || expanded || slides.length <= VISIBLE;
  }

  prevBtn?.addEventListener('click', () => { offset = Math.max(0, offset - VISIBLE); update(); });
  nextBtn?.addEventListener('click', () => { offset = Math.min(slides.length - VISIBLE, offset + VISIBLE); update(); });
  showMoreBtn?.addEventListener('click', () => { expanded = true; update(); });

  update();
  window.addEventListener('resize', update);
});
</script>

<style>
  .carousel-wrapper { position: relative; }

  .carousel-nav {
    display: flex;
    justify-content: flex-end;
    gap: 0.5rem;
    margin-bottom: 1rem;
  }

  .carousel-btn {
    background: none;
    border: 2px solid currentColor;
    border-radius: 50%;
    width: 2.5rem;
    height: 2.5rem;
    font-size: 1.5rem;
    line-height: 1;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0.6;
    transition: opacity 0.15s;
    color: inherit;
  }

  .carousel-btn:hover:not(:disabled) { opacity: 1; }
  .carousel-btn:disabled { opacity: 0.25; cursor: default; }

  .carousel-show-more {
    display: block;
    width: 100%;
    margin-top: 1.25rem;
    padding: 0.75rem 1rem;
    background: none;
    border: 1px solid currentColor;
    border-radius: 0.5rem;
    cursor: pointer;
    font-size: 0.9rem;
    opacity: 0.75;
    color: inherit;
    font-family: inherit;
  }

  .carousel-show-more:hover { opacity: 1; }
</style>
