---
interface Props {
  title: string;
  date: string;
  time: string;
  endTime?: string;
  venue: string;
  type: 'social' | 'class' | 'festival';
  description?: string;
  ticketUrl?: string | null;
  infoUrl?: string | null;
}
const { title, date, time, endTime, venue, type, description, ticketUrl, infoUrl } = Astro.props;

const dateObj = new Date(date + 'T' + time);
const formatted = dateObj.toLocaleDateString('en-GB', { weekday: 'short', day: 'numeric', month: 'short' });
const timeRange = endTime ? `${time} – ${endTime}` : time;
---
<article class={`event-card event-card--${type}`}>
  <div class="event-card-top"></div>
  <div class="event-card-body">
    <span class={`event-badge event-badge--${type}`}>{type}</span>
    <h3>{title}</h3>
    <p class="event-meta">
      <time datetime={date}>{formatted}</time> &middot; {timeRange}
    </p>
    <p class="event-meta">{venue}</p>
    {description && <p class="event-desc">{description}</p>}
    {(ticketUrl || infoUrl) && (
      <div class="event-links">
        {ticketUrl && <a href={ticketUrl} class="event-link event-link--ticket" target="_blank" rel="noopener">Get Tickets</a>}
        {infoUrl && <a href={infoUrl} class="event-link" target="_blank" rel="noopener">More Info</a>}
      </div>
    )}
  </div>
</article>
