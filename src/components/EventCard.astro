---
interface Props {
  title: string;
  date: string;
  time: string;
  endTime?: string;
  venue: string;
  type: 'social' | 'class' | 'festival';
  description?: string;
  pictureUrl?: string;
  detailUrl: string;
}
const { title, date, time, endTime, venue, type, description, pictureUrl, detailUrl } = Astro.props;

const dateObj = new Date(date + 'T' + time);
const formatted = dateObj.toLocaleDateString('en-GB', { weekday: 'short', day: 'numeric', month: 'short' });
const timeRange = endTime ? `${time} – ${endTime}` : time;
---
<a href={detailUrl} target="_blank" rel="noopener noreferrer" class="event-card-link">
  <article class={`event-card event-card--${type}${pictureUrl ? ' has-image' : ''}`}>
    {pictureUrl
      ? <img src={pictureUrl} alt={title} class="event-card-img" />
      : <div class="event-card-top"></div>
    }
    <div class="event-card-body">
      <span class={`event-badge event-badge--${type}`}>{type}</span>
      <h3>{title}</h3>
      <p class="event-meta">
        <time datetime={date}>{formatted}</time> &middot; {timeRange}
      </p>
      <p class="event-meta">{venue}</p>
      {description && <p class="event-desc">{description}</p>}
    </div>
  </article>
</a>
