---
// Homepage top bar: name left, logo right. No links — the cards navigate.
const base = import.meta.env.BASE_URL;
---
<header class="topbar">
  {/* This is the homepage's only h1. The cards are all h2s, so without it
      the most important page in the site had no top-level heading at all. */}
  <h1 class="topbar__name">Tome Forró Berlin</h1>

  {/* Explicit dimensions reserve the box before load, so the bar doesn't
      shift when the logo arrives (CLS is a Core Web Vital). */}
  <img
    class="topbar__logo"
    src={`${base}/images/v6/logo.webp`}
    alt="Tome Forró Berlin e.V. logo"
    width="240"
    height="224"
    fetchpriority="high"
  />
</header>
