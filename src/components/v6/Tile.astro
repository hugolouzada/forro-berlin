---
// Homepage card. Same shape as NextEventTile: full-opacity photo, solid
// accent banner pinned to the bottom, and on hover an accent panel rides up
// over the photo while the blurb expands the banner.
interface Props {
  id: string;
  title: string;
  /** Hover-revealed blurb. */
  intro: string;
  href: string;
  img: string;
  external?: boolean;
}
const { id, title, intro, href, img, external = false } = Astro.props;
---
<a
  class={`tile tile--${id}`}
  href={href}
  style={`--tile-img: url('${img}')`}
  transition:name={`card-${id}`}
  target={external ? '_blank' : undefined}
  rel={external ? 'noopener noreferrer' : undefined}
>
  <span class="tile__photoband" aria-hidden="true"></span>

  {/* Slides up from behind the banner on hover to cover the photo. */}
  <span class="tile__cover" aria-hidden="true"></span>

  <div class="tile__body">
    <h2 class="tile__title">{title}</h2>
    <div class="tile__reveal">
      <div><p class="tile__meta">{intro}</p></div>
    </div>
  </div>

  <span class="tile__cue" aria-hidden="true">&rarr;</span>
</a>
