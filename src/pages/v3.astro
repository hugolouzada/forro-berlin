---
import BaseLayout from '../layouts/BaseLayout.astro';
import EventCarousel from '../components/EventCarousel.astro';
import FAQItem from '../components/FAQItem.astro';
import { getUpcomingBerlinEvents } from '../lib/fetchEvents';
import faqData from '../data/faq.json';

const upcoming = await getUpcomingBerlinEvents();
const thisWeek = upcoming.slice(0, 3);
---
<BaseLayout
  title="Forró Berlin — Classes, Socials &amp; Events"
  description="Find forró classes, weekly socials, and upcoming events in Berlin. All levels welcome."
  cssFile="/styles/v3.css"
>
  <nav class="site-nav">
    <a href="#" class="logo">Forró Berlin</a>
    <ul>
      <li><a href="#events">Events</a></li>
      <li><a href="#what-is-forro">About</a></li>
      <li><a href="#faq">FAQ</a></li>
      <li><a href="#links">Get Involved</a></li>
    </ul>
  </nav>

  <section class="hero">
    <h1>Forró in Berlin</h1>
    <p>Your guide to classes, weekly socials, and upcoming events. All levels welcome.</p>
    <a href="#events" class="cta-btn">See All Events</a>
  </section>

  <div class="this-week-strip">
    <p><strong>Coming up soon:</strong></p>
    <div class="strip-events">
      {thisWeek.map(e => (
        <a href="#events" class="strip-event-chip">
          {new Date(e.date + 'T12:00:00').toLocaleDateString('en-GB', { weekday: 'short', day: 'numeric', month: 'short' })} — {e.title}
        </a>
      ))}
    </div>
  </div>

  <section class="what-is-forro" id="what-is-forro">
    <div class="what-is-forro-inner">
      <h2 class="section-title">What is Forró?</h2>
      <p>
        Forró is a joyful partner dance from northeastern Brazil, danced to accordion, zabumba drum,
        and triangle. It's social, easy to learn, and genuinely fun — most people are dancing by the
        end of their first class. Berlin has one of Europe's most welcoming forró communities.
        No partner needed, no experience required.
      </p>
    </div>
  </section>

  <section class="events-section" id="events">
    <div class="events-inner">
      <h2 class="section-title">Upcoming Events</h2>
      <p class="section-subtitle">Classes, socials, and festivals — all in one place.</p>
      <EventCarousel events={upcoming} bgColor="fffbf5" />
    </div>
  </section>

  <section class="faq-section" id="faq">
    <div class="faq-inner">
      <h2 class="section-title">Frequently Asked Questions</h2>
      <p class="section-subtitle">Everything you need to know before your first class.</p>
      {faqData.faq.map(item => (
        <FAQItem question={item.question} answer={item.answer} />
      ))}
    </div>
  </section>

  <section class="links-section" id="links">
    <div class="links-inner">
      <h2 class="section-title">Get Involved</h2>
      <p class="section-subtitle">Find the right entry point for you.</p>
      <div class="persona-grid">
        <div class="persona-card">
          <div class="persona-icon">🌱</div>
          <h3>New to Forró?</h3>
          <p>Start with a beginner class — no partner needed, no experience required. You'll be dancing in an hour.</p>
          <a href="#events" class="persona-btn">Find a Class</a>
        </div>
        <div class="persona-card">
          <div class="persona-icon">💃</div>
          <h3>Regular Dancer?</h3>
          <p>Check the calendar for weekly socials and workshops with visiting teachers from Brazil and beyond.</p>
          <a href="#events" class="persona-btn">See All Events</a>
        </div>
        <div class="persona-card">
          <div class="persona-icon">🎉</div>
          <h3>Planning an Event?</h3>
          <p>Organising a forró festival or workshop in Berlin? We'd love to list it here. Get in touch.</p>
          <a href="mailto:info@forro-berlin.de" class="persona-btn">Contact Us</a>
        </div>
      </div>
    </div>
  </section>

  <footer class="site-footer">
    <p>&copy; {new Date().getFullYear()} Forró Berlin &mdash; <a href={import.meta.env.BASE_URL}>Back to design picker</a></p>
  </footer>
</BaseLayout>
