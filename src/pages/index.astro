---
import V6Layout from '../layouts/V6Layout.astro';
import TopBar from '../components/v6/TopBar.astro';
import SiteFooter from '../components/v6/SiteFooter.astro';
import Tile from '../components/v6/Tile.astro';
import NextEventTile from '../components/v6/NextEventTile.astro';
import type { NextUp } from '../components/v6/NextEventTile.astro';
import { getUpcomingBerlinEvents, TOME_FORRO_HOST_ID } from '../lib/fetchEvents';

// PLACEHOLDER — see src/data/exampleEvents.json. Remove this import and the
// `examples` block below before the site goes public.
import exampleData from '../data/exampleEvents.json';

const base = import.meta.env.BASE_URL;

// PLACEHOLDER pricing — flat figure for typesetting, matching the calendar.
const PLACEHOLDER_PRICE = '€10';

// The Next Event card shows OUR events only — the feed aggregates several
// Berlin organizers, so filter by host. Our own event pages are candidates
// too, and they win the link: an event we wrote a page for should send
// people to that page, not to the aggregator's listing.
const live: NextUp[] = (await getUpcomingBerlinEvents())
  .filter(e => e.hostId === TOME_FORRO_HOST_ID)
  .map(e => ({
    title: e.title,
    date: e.date,
    time: e.time,
    endTime: e.endTime,
    venue: e.venue,
    price: PLACEHOLDER_PRICE,
    image: e.pictureUrl ?? `${base}/images/v6/events.webp`,
    href: `${e.detailUrl}?backgroundColor=121212`,
    external: true,
  }));

const examples: NextUp[] = exampleData.events
  .filter(e => e.ours && e.slug)
  .map(e => ({
    title: e.title,
    date: e.date,
    time: e.time,
    endTime: e.endTime,
    venue: e.venue,
    price: PLACEHOLDER_PRICE,
    image: `${base}/images/v6/${e.image}`,
    href: `${base}/our-events/${e.slug}`,
    external: false,
  }));

const nextEvent = [...live, ...examples].sort((a, b) =>
  (a.date + a.time).localeCompare(b.date + b.time)
)[0];
---
<V6Layout
  home
  title="Tome Forró Berlin — Classes, Socials &amp; Events"
  description="Find forró classes, weekly socials, and upcoming events in Berlin. All levels welcome."
>
  <TopBar />

  <div class="grid">
    <NextEventTile event={nextEvent} />

    <Tile
      id="calendar"
      title="Class &amp; Event Calendar"
      intro="Every weekly class and social across the city, from all Berlin organizers — filter by what you're looking for."
      href={`${base}/calendar`}
      img={`${base}/images/v6/calendar.webp`}
    />

    <Tile
      id="external-links"
      title="External Links"
      intro="Festival calendars, partner organizers, and other forró resources worth knowing about."
      href={`${base}/external-links`}
      img={`${base}/images/v6/external-links.webp`}
    />

    <Tile
      id="our-events"
      title="Our Events"
      intro="Parties, workshops, and concerts organised by Tome Forró Berlin e.V."
      href={`${base}/our-events`}
      img={`${base}/images/v6/our-events.webp`}
    />

    <Tile
      id="about"
      title="What is Forró?"
      intro="A joyful partner dance from northeastern Brazil, danced to accordion, zabumba drum, and triangle."
      href={`${base}/about`}
      img={`${base}/images/v6/about.webp`}
    />

    <Tile
      id="faq"
      title="FAQ &amp; Conduct"
      intro="No partner needed. No experience required. Everything you need to know before your first class."
      href={`${base}/faq`}
      img={`${base}/images/v6/faq.webp`}
    />
  </div>

  <SiteFooter />
</V6Layout>
