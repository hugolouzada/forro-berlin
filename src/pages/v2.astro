---
import BaseLayout from '../layouts/BaseLayout.astro';
import EventCarousel from '../components/EventCarousel.astro';
import FAQItem from '../components/FAQItem.astro';
import { getUpcomingBerlinEvents } from '../lib/fetchEvents';
import faqData from '../data/faq.json';

const upcoming = await getUpcomingBerlinEvents();
---
<BaseLayout
  title="Forró Berlin — Classes, Socials &amp; Events"
  description="Find forró classes, weekly socials, and upcoming events in Berlin. All levels welcome."
  cssFile="/styles/v2.css"
>
  <nav class="site-nav">
    <a href="#" class="logo">Forró Berlin</a>
    <ul>
      <li><a href="#events">Events</a></li>
      <li><a href="#what-is-forro">About</a></li>
      <li><a href="#faq">FAQ</a></li>
      <li><a href="#links">Links</a></li>
    </ul>
  </nav>

  <section class="hero">
    <h1>FORRÓ<br/><span class="accent">BERLIN</span></h1>
    <p>Classes, weekly socials, and festivals. All levels. Every week.</p>
    <a href="#events" class="cta-btn">See Upcoming Events</a>
  </section>

  <div class="skew-divider"></div>

  <section class="what-is-forro" id="what-is-forro">
    <div class="what-is-forro-inner">
      <h2 class="section-title">What is <span class="accent">Forró?</span></h2>
      <p>
        Forró is a partner dance from northeastern Brazil — accordion, percussion, rhythm.
        It's social, accessible, and addictive. No partner needed, no experience required.
        Berlin's forró community is one of Europe's most welcoming. Show up, dance, repeat.
      </p>
    </div>
  </section>

  <div class="skew-divider"></div>

  <section class="events-section" id="events">
    <div class="events-inner">
      <h2 class="section-title">Upcoming <span class="accent">Events</span></h2>
      <p class="section-subtitle">Updated regularly — check back often.</p>
      <EventCarousel events={upcoming} bgColor="0f0f0f" />
    </div>
  </section>

  <div class="skew-divider"></div>

  <section class="faq-section" id="faq">
    <div class="faq-inner">
      <h2 class="section-title">FAQ</h2>
      {faqData.faq.map(item => (
        <FAQItem question={item.question} answer={item.answer} />
      ))}
    </div>
  </section>

  <div class="skew-divider"></div>

  <section class="links-section" id="links">
    <h2>Ready to Dance?</h2>
    <p>Find a class, join a social, or get tickets to the next festival.</p>
    <div class="links-cta-group">
      <a href="#events" class="links-cta-btn">All Events</a>
      <a href="#faq" class="links-cta-btn links-cta-btn--outline">Learn More</a>
    </div>
  </section>

  <footer class="site-footer">
    <p>&copy; {new Date().getFullYear()} Forró Berlin &mdash; <a href={import.meta.env.BASE_URL}>Back to design picker</a></p>
  </footer>
</BaseLayout>
