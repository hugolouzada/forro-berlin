---
import BaseLayout from '../layouts/BaseLayout.astro';
import EventCard from '../components/EventCard.astro';
import FAQItem from '../components/FAQItem.astro';
import eventsData from '../data/events.json';
import faqData from '../data/faq.json';

const today = new Date().toISOString().split('T')[0];
const upcoming = eventsData.events
  .filter(e => e.date >= today)
  .sort((a, b) => a.date.localeCompare(b.date));
---
<BaseLayout
  title="Forró Berlin — Classes, Socials &amp; Events"
  description="Find forró classes, weekly socials, and upcoming events in Berlin. All levels welcome."
  fontUrl="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,700;1,700&family=Lato:wght@400;700&display=swap"
  cssFile="/styles/v1.css"
>
  <nav class="site-nav">
    <a href="#" class="logo">Forró Berlin</a>
    <ul>
      <li><a href="#events">Events</a></li>
      <li><a href="#what-is-forro">About</a></li>
      <li><a href="#faq">FAQ</a></li>
      <li><a href="#links">Links</a></li>
    </ul>
  </nav>

  <section class="hero">
    <h1>Dance Forró<br/>in Berlin</h1>
    <p>Classes, weekly socials, and festivals — all in one place. Open to everyone.</p>
    <a href="#events" class="cta-btn">See This Week's Events</a>
  </section>

  <div class="wave-divider">
    <svg viewBox="0 0 1440 60" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="none">
      <path d="M0,30 C360,60 1080,0 1440,30 L1440,60 L0,60 Z" fill="#FFF8F0"/>
    </svg>
  </div>

  <section class="what-is-forro" id="what-is-forro">
    <div class="what-is-forro-inner">
      <h2 class="section-title">What is Forró?</h2>
      <p>
        Forró is a joyful partner dance from northeastern Brazil, danced to the irresistible rhythms of
        accordion, zabumba drum, and triangle. It's deeply social, surprisingly easy to learn, and
        endlessly fun to dance. Whether you've never danced before or you're a seasoned mover,
        Berlin's forró community welcomes you with open arms — and open dance floors.
      </p>
    </div>
  </section>

  <div class="wave-divider">
    <svg viewBox="0 0 1440 60" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="none">
      <path d="M0,30 C360,0 1080,60 1440,30 L1440,60 L0,60 Z" fill="#FDF6EC"/>
    </svg>
  </div>

  <section class="events-section" id="events">
    <div class="events-inner">
      <h2 class="section-title">Upcoming Events</h2>
      <p class="section-subtitle">Classes, socials, and festivals — updated regularly.</p>
      <div class="events-grid">
        {upcoming.map(event => (
          <EventCard
            title={event.title}
            date={event.date}
            time={event.time}
            endTime={event.endTime}
            venue={event.venue}
            type={event.type as 'social' | 'class' | 'festival'}
            description={event.description}
            ticketUrl={event.ticketUrl}
            infoUrl={event.infoUrl}
          />
        ))}
      </div>
    </div>
  </section>

  <div class="wave-divider">
    <svg viewBox="0 0 1440 60" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="none">
      <path d="M0,30 C360,60 1080,0 1440,30 L1440,60 L0,60 Z" fill="#FFF8F0"/>
    </svg>
  </div>

  <section class="faq-section" id="faq">
    <div class="faq-inner">
      <h2 class="section-title">Frequently Asked Questions</h2>
      {faqData.faq.map(item => (
        <FAQItem question={item.question} answer={item.answer} />
      ))}
    </div>
  </section>

  <div class="wave-divider">
    <svg viewBox="0 0 1440 60" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="none">
      <path d="M0,30 C360,0 1080,60 1440,30 L1440,60 L0,60 Z" fill="#2D6A4F"/>
    </svg>
  </div>

  <section class="links-section" id="links">
    <h2>Ready to Dance?</h2>
    <p>Find a class, join a social, or grab tickets to the next big event.</p>
    <div class="links-cta-group">
      <a href="#events" class="links-cta-btn">View All Events</a>
      <a href="#faq" class="links-cta-btn links-cta-btn--outline">Learn More</a>
    </div>
  </section>

  <footer class="site-footer">
    <p>&copy; {new Date().getFullYear()} Forró Berlin &mdash; <a href="/">Back to design picker</a></p>
  </footer>
</BaseLayout>
