// The technical-writer ruleset is deliberately NOT applied here. This is
// German statutory text under § 5 TMG. Its wording carries legal effect, and
// the disclaimer is a standard eRecht24 template. Editing it for style could
// weaken the protection it exists to provide. Kept verbatim, in German, with
// only the layout changed.
import V6Layout from '../layouts/V6Layout.astro';
import Panel from '../components/v6/Panel.astro';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: 'Impressum',
  inLanguage: 'de',
};
---
<V6Layout
  ink
  schema={schema}
  title="Impressum — Tome Forró Berlin"
  description="Impressum und Haftungsausschluss für Tome Forró Berlin e.V., brasilianischer Kultur- und Sportverein in Berlin."
>
  <Panel
    id="imprint"
    label="Angaben gemäß § 5 TMG"
    title="Impressum"
  >
    <div class="panel__body" lang="de">
      <dl class="factlist">
        <div class="factlist__row">
          <dt>Verein</dt>
          <dd>Tome Forró Berlin &ndash; brasilianischer Kultur- und Sportverein</dd>
        </div>
        <div class="factlist__row">
          <dt>Vertreten durch</dt>
          {/* Names removed at the client's request (outdated). § 5 Abs. 1 Nr. 1
              TMG requires the Vertretungsberechtigter to be named for a Verein,
              so the current Vorstand names must be added back before launch. */}
          <dd>Die Vorsitzenden des Vereins</dd>
        </div>
        <div class="factlist__row">
          <dt>E-Mail</dt>
          <dd><a href="mailto:tomeforroberlin@gmail.com">tomeforroberlin@gmail.com</a></dd>
        </div>
      </dl>

      <p class="factnote">
        Inhaltlich Verantwortlicher gemäß § 6 MDStV: vertreten durch die Vorsitzenden.
      </p>

      <hr class="panel__rule" />

